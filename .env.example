# Copy to .env and fill in real values. Never commit .env.

# Local lakehouse (docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# Azure (only needed once Phase 6 / cloud deployment is attempted; leave blank for local dev)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_RESOURCE_GROUP=rg-ai-energy-mobility-dev

# French open-data sources (most need no key; RTE eco2mix v5 requires a free OAuth2 client)
RTE_ECO2MIX_CLIENT_ID=
RTE_ECO2MIX_CLIENT_SECRET=
POSTGRES_PASSWORD=change_me
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
DATABASE_URL=postgresql://aem_user:change_me@localhost:5433/aem_platform
